<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="24sp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="18sp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Configuration (stop monitoring before editing)" android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/check_interval"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="number"
            android:hint="Check interval in milliseconds (1000–60000)" />
        <EditText
            android:id="@+id/gateway_override"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textNoSuggestions"
            android:hint="Router IPv4 override (blank = auto)" />
        <EditText
            android:id="@+id/internet_target"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="textNoSuggestions"
            android:hint="Internet IPv4 address (TCP port 443)" />
        <EditText
            android:id="@+id/failure_threshold"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:inputType="number"
            android:hint="Consecutive failures (1–10)" />
        <CheckBox
            android:id="@+id/start_after_reboot"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/start_after_reboot" />
        <Button
            android:id="@+id/save_configuration"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="Save configuration" />
        <Button
            android:id="@+id/start_monitoring"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/start_monitoring" />
        <Button
            android:id="@+id/stop_monitoring"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/stop_monitoring" />
        <Button
            android:id="@+id/view_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/view_log" />
        <Button
            android:id="@+id/export_csv"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/export_csv" />
        <Button
            android:id="@+id/clear_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/clear_log" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/log_note" android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/event_log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textIsSelectable="true" android:fontFamily="monospace"
            android:textSize="12sp" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
